---
import BaseLayout from "../layouts/BaseLayout.astro";
import Contacto from "../components/Contacto.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Identidad from "../components/Identidad.astro";
import Proceso from "../components/Proceso.astro";
import Proyectos from "../components/Proyectos.astro";
import Servicios from "../components/Servicios.astro";

const title = "SomosInformáticos — Desarrollo web que sí funciona";
const description =
  "Diseño y desarrollo de sitios web modernos, landing pages, sitios corporativos e integraciones. Tecnología clara, cercana y confiable.";
---

<BaseLayout {title} {description}>
  <Header />
  <main id="inicio">
    <Hero />
    <Servicios />
    <Proyectos />
    <Identidad />
    <Proceso />
    <Contacto />
  </main>
  <Footer />
</BaseLayout>
