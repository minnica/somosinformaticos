---
const services = [
  {
    number: "01",
    label: "Diseño y desarrollo web",
    title: "Sitios que se ven bien y trabajan mejor.",
    description:
      "Diseñamos interfaces claras y las convertimos en sitios rápidos, responsivos y listos para crecer contigo.",
    chips: ["UI/UX", "Frontend", "Responsive", "Performance"],
  },
  {
    number: "02",
    label: "Landing pages",
    title: "Una página. Un objetivo claro.",
    description:
      "Landing pages enfocadas en campañas, servicios, lanzamientos y generación de prospectos.",
    chips: ["Campañas", "Lanzamientos", "Conversión"],
  },
  {
    number: "03",
    label: "Sitios administrables",
    title: "Tu contenido, bajo tu control.",
    description:
      "Sitios con CMS para editar textos, imágenes, servicios y contenido sin depender de código.",
    chips: ["CMS", "Contenido", "Escalabilidad"],
  },
  {
    number: "04",
    label: "SEO + rendimiento",
    title: "Rápida, encontrable y bien construida.",
    description:
      "Optimizamos estructura, velocidad, accesibilidad y SEO técnico desde la base.",
    chips: ["SEO técnico", "Accesibilidad", "Core Web Vitals"],
  },
  {
    number: "05",
    label: "Integraciones",
    title: "Tu sitio conectado con lo que necesitas.",
    description:
      "Formularios, reservas, pagos, analítica, CRM, APIs y automatizaciones para convertir tu web en una herramienta de negocio.",
    chips: ["APIs", "Analytics", "Pagos", "Reservas"],
  },
];
---

<section id="servicios" aria-labelledby="servicios-title">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="section-intro">De la primera idea al sitio publicado.</p>
      <div>
        <h2 id="servicios-title">Todo lo que una buena web necesita. Nada de lo que no.</h2>
        <p>
          Combinamos pensamiento estratégico, diseño y tecnología en un solo equipo.
          Menos intermediarios, decisiones más rápidas y una experiencia coherente.
        </p>
      </div>
    </div>

    <div class="service-list">
      {
        services.map((service) => (
          <article class="service-row reveal">
            <span class="service-num">{service.number}</span>
            <div class="service-title">
              <span>{service.label}</span>
              <h3>{service.title}</h3>
            </div>
            <div class="service-detail">
              <p>{service.description}</p>
              <div class="chiprow">{service.chips.map((chip) => <span class="chip">{chip}</span>)}</div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
