---
const links = [
  { href: "#servicios", label: "Servicios" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#proceso", label: "Proceso" },
  { href: "#contacto", label: "Contacto" },
];
---

<header class="nav-shell">
  <nav aria-label="Navegación principal">
    <a class="brand" href="#inicio" aria-label="SomosInformáticos, ir al inicio">
      <span class="brand-mark" aria-hidden="true">Si<b>_</b></span>
      <span class="brand-name">SomosInformáticos</span>
    </a>

    <div class="navlinks" id="navlinks">
      {links.map(({ href, label }) => <a href={href}>{label}</a>)}
    </div>

    <div class="nav-cta">
      <a class="btn dark magnetic" href="#contacto">
        Hablemos <span class="arrow" aria-hidden="true">↗</span>
      </a>
      <button
        class="menu"
        id="menuBtn"
        type="button"
        aria-label="Abrir menú"
        aria-controls="navlinks"
        aria-expanded="false"
      >
        <i aria-hidden="true"></i>
      </button>
    </div>
  </nav>
</header>
