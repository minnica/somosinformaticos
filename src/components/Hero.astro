---
const capabilities = [
  "Landing pages",
  "Sitios corporativos",
  "UI/UX",
  "Responsive",
  "SEO técnico",
  "Integraciones",
  "CMS",
];

const trustPoints = ["Estrategia", "Diseño", "Código", "Lanzamiento"];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="reveal show">
      <div class="hero-note"><span class="pulse"></span>Estudio web independiente · México / remoto</div>
      <h1 id="hero-title">
        Webs que convierten el “tal vez” en <span class="accent-line">sí.</span>
      </h1>
      <p class="lead">
        Diseñamos y desarrollamos sitios claros, rápidos y con carácter para negocios
        que quieren explicar mejor lo que hacen y convertir visitas en oportunidades.
      </p>
      <div class="actions">
        <a class="btn lime magnetic" href="#contacto">
          Cuéntanos tu idea <span class="arrow" aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="#proyectos">Ver cómo lo hacemos <span aria-hidden="true">↓</span></a>
      </div>
      <div class="trust" aria-label="Características del servicio">
        {trustPoints.map((point, index) => <span><b>{index + 1}</b>{point}</span>)}
      </div>
    </div>

    <div class="hero-workbench reveal show" id="heroTilt" role="img" aria-label="Prototipo de una experiencia web creada por SomosInformáticos">
      <div class="workbench-bar" aria-hidden="true">
        <span class="workbench-dots"><i></i><i></i><i></i></span>
        <span>Vista previa · escritorio</span>
        <span class="workbench-status">En línea</span>
      </div>
      <div class="workbench-canvas" aria-hidden="true">
        <aside class="demo-rail">
          <b>Si_</b>
          <div><i></i><i></i><i></i></div>
          <span>01</span>
        </aside>
        <div class="demo-site">
          <div class="demo-nav"><b>Norte</b><span>Servicios&nbsp;&nbsp; Estudio&nbsp;&nbsp; Contacto</span><i>Hablemos ↗</i></div>
          <div class="demo-hero">
            <p>Consultoría estratégica</p>
            <h2>Decisiones claras.<br />Resultados visibles.</h2>
            <div class="demo-copy"><span></span><span></span><span></span></div>
            <i class="demo-button">Empecemos ↗</i>
          </div>
          <div class="demo-proof">
            <span><b>01</b>Estrategia</span><span><b>02</b>Implementación</span><span><b>03</b>Resultados</span>
          </div>
        </div>
      </div>
      <div class="stage-note stage-note-speed"><b>Rápida</b><span>Carga optimizada</span></div>
      <div class="stage-note stage-note-mobile"><b>Flexible</b><span>Diseño responsive</span></div>
    </div>
  </div>
</section>

<div class="ticker" aria-label="Servicios y capacidades">
  <div class="ticker-track">
    <div class="ticker-group">
      {capabilities.map((capability) => <span>{capability}</span>)}
    </div>
    <div class="ticker-group" aria-hidden="true">
      {capabilities.map((capability) => <span>{capability}</span>)}
    </div>
  </div>
</div>
